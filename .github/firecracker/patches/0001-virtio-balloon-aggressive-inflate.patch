From: openworld-kernel <noreply@openworld>
Subject: [PATCH] virtio_balloon: fast progress and full OOM relief with stock VMMs

Keep the upstream 256-PFN (1 MiB) descriptor size. Stock Firecracker
rejects larger inflate descriptors; it does not split them. Small batches
also reduce the contiguous allocation needed for struct virtio_balloon.

Publish partially filled batches immediately rather than sleeping before
telling the host. Back off for 200ms only when no pages were obtained,
outside balloon_lock so OOM deflation can run during the wait.

Drain up to 128 MiB on an OOM notification, across stock-sized descriptors.
Stop if the balloon is empty or no page can be dequeued. Host policy must
still lower the target under pressure; deflate_on_oom is a last resort.

Signed-off-by: openworld-kernel <noreply@openworld>
---
diff --git a/drivers/virtio/virtio_balloon.c b/drivers/virtio/virtio_balloon.c
--- a/drivers/virtio/virtio_balloon.c
+++ b/drivers/virtio/virtio_balloon.c
@@ -28,7 +28,7 @@
 #define VIRTIO_BALLOON_PAGES_PER_PAGE (unsigned int)(PAGE_SIZE >> VIRTIO_BALLOON_PFN_SHIFT)
 #define VIRTIO_BALLOON_ARRAY_PFNS_MAX 256
 /* Maximum number of (4k) pages to deflate on OOM notifications. */
-#define VIRTIO_BALLOON_OOM_NR_PAGES 256
+#define VIRTIO_BALLOON_OOM_NR_PAGES 32768
 #define VIRTIO_BALLOON_OOM_NOTIFY_PRIORITY 80
 
 #define VIRTIO_BALLOON_FREE_PAGE_ALLOC_FLAG (__GFP_NORETRY | __GFP_NOWARN | \
@@ -258,8 +258,6 @@
 			dev_info_ratelimited(&vb->vdev->dev,
 					     "Out of puff! Can't get %u pages\n",
 					     VIRTIO_BALLOON_PAGES_PER_PAGE);
-			/* Sleep for at least 1/5 of a second before retry. */
-			msleep(200);
 			break;
 		}
 
@@ -287,6 +285,10 @@
 		tell_host(vb, vb->inflate_vq);
 	mutex_unlock(&vb->balloon_lock);
 
+	/* Publish progress promptly; only back off when nothing is reclaimable. */
+	if (!num_allocated_pages)
+		msleep(200);
+
 	return num_allocated_pages;
 }
 
@@ -913,9 +915,18 @@
 	struct virtio_balloon *vb = container_of(nb,
 						 struct virtio_balloon, oom_nb);
 	unsigned long *freed = parm;
+	unsigned long remaining = VIRTIO_BALLOON_OOM_NR_PAGES;
+	unsigned long got;
 
-	*freed += leak_balloon(vb, VIRTIO_BALLOON_OOM_NR_PAGES) /
-		  VIRTIO_BALLOON_PAGES_PER_PAGE;
+	/* Each leak is capped at one stock-compatible descriptor. */
+	while (remaining) {
+		got = leak_balloon(vb, remaining);
+		if (!got)
+			break;
+		*freed += got / VIRTIO_BALLOON_PAGES_PER_PAGE;
+		remaining -= got;
+		cond_resched();
+	}
 	update_balloon_size(vb);
 
 	return NOTIFY_OK;
