# Minimal Linux 6.18 LTS kernel config for Firecracker microVMs (x86_64).
# Size-optimized (-Os): targets a ~10 MB vmlinux image.
# Applied on top of linux-stable linux-6.18.y via `make olddefconfig`.
#
# EXPERT=y is required so that Kconfig defaults (`default y` on VT, WLAN,
# legacy PTYs, ACPI sub-drivers, ...) can be turned off. Without it those
# defaults silently override the fragment.

CONFIG_EXPERT=y

# Turn off -ftrivial-auto-var-init (kernel stack zeroing). It costs text size
# across the whole kernel; Firecracker microVMs get fresh pages each boot, so
# the defense is less valuable than the ~0.4 MB it costs.
CONFIG_INIT_STACK_NONE=y

# Disable modules - build a fully static, self-contained kernel.
# CONFIG_MODULES is not set

CONFIG_LOCALVERSION="-openworld"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="(none)"

# Size-optimize instead of performance to keep the image around ~10 MB.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# General setup
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_AUDIT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# CONFIG_KALLSYMS is not set

# Disable x86 CPU vendors that a modern microVM never sees. PROCESSOR_SELECT
# makes the per-vendor prompts visible so the "not set" lines are honored.
CONFIG_PROCESSOR_SELECT=y
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# CONFIG_HW_RANDOM_AMD is not set
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_VIA is not set
# CONFIG_INTEL_MEI is not set
# CONFIG_HWMON is not set

# Processor type and features (x86_64)
CONFIG_SMP=y
CONFIG_NR_CPUS=32
CONFIG_HZ_250=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_PCSPKR_PLATFORM is not set
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_ACPI_PROCESSOR is not set

# MicroVMs boot the guest kernel cold; no speculative-execution mitigation
# thunks needed (matches the pre-6.18 openworld kernel).
# CONFIG_MITIGATION_RETPOLINE is not set
# CONFIG_MITIGATION_RETHUNK is not set
# CONFIG_MITIGATION_IBPB_ENTRY is not set
# CONFIG_MITIGATION_IBRS_ENTRY is not set
# CONFIG_MITIGATION_SLS is not set
# CONFIG_MITIGATION_GDS is not set
# CONFIG_MITIGATION_RFDS is not set
# CONFIG_MITIGATION_SPECTRE_BHI is not set
# CONFIG_MITIGATION_MDS is not set
# CONFIG_MITIGATION_TAA is not set
# CONFIG_MITIGATION_MMIO_STALE_DATA is not set
# CONFIG_MITIGATION_L1TF is not set
# CONFIG_MITIGATION_SPECTRE_V1 is not set
# CONFIG_MITIGATION_SPECTRE_V2 is not set
# CONFIG_MITIGATION_SRBDS is not set
# CONFIG_MITIGATION_SSB is not set

# Power management is not needed in a microVM (no battery, fan, thermal,
# suspend or CPU frequency scaling).
# CONFIG_PM is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_ACPI_AC is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_BUTTON is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_THERMAL is not set
# CONFIG_ACPI_DEBUG is not set
# CONFIG_ACPI_TABLE_UPGRADE is not set

# Firecracker on x86_64 uses the virtio-PCI transport, so PCI stays on,
# but without PCIe port services (AER/power management).
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
# CONFIG_PCIEPORTBUS is not set
# CONFIG_PCIEASPM is not set
# CONFIG_PCI_LABEL is not set
CONFIG_ACPI=y
# CONFIG_ACPI_SPCR_TABLE is not set
# CONFIG_INTEL_IOMMU is not set
# CONFIG_AMD_IOMMU is not set
# CONFIG_IOMMU_SUPPORT is not set

# x86 architecture trims that do not affect Firecracker functionality
# (each defaults to y on x86_64 and bloats the image needlessly).
# CONFIG_FUNCTION_ALIGNMENT_16B is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RANDOMIZE_MEMORY is not set
# CONFIG_HALTPOLL_CPUIDLE is not set
# CONFIG_MTRR is not set
# CONFIG_MTRR_SANITIZER is not set
# CONFIG_EDAC_SUPPORT is not set
# CONFIG_VGA_ARB is not set
# CONFIG_PNP_DEBUG_MESSAGES is not set
# CONFIG_SERIAL_8250_DEPRECATED_OPTIONS is not set

# Partition types
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# CONFIG_MQ_IOSCHED_KYBER is not set

# Networking - IPv4 + IPv6 + AF_UNIX + vsock + 9p, keep it lean.
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set
# CONFIG_PTP_1588_CLOCK is not set
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# Device drivers - virtio block/net/console/balloon
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
# CONFIG_VIRTIO_MMIO is not set

# Serial console (Firecracker requirement). The 16550 UART is a legacy
# port, so only the base 8250 + PnP/ACPI probe is needed - no PCI serial,
# no SoC/PCIe serial-card quirks (they default to y with SERIAL_8250).
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y
# CONFIG_SERIAL_8250_PCI is not set
# CONFIG_SERIAL_8250_PCILIB is not set
# CONFIG_SERIAL_8250_EXAR is not set
# CONFIG_SERIAL_8250_LPSS is not set
# CONFIG_SERIAL_8250_MID is not set
# CONFIG_SERIAL_8250_PERICOM is not set
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO_I8042 is not set

# Disable host-oriented subsystems and unneeded instrumentation. PERF_EVENTS
# itself is select-only (forced by arch/x86), so kill its uncore/RAPL/CSTATE
# PMU drivers; ORC unwinder tables cost ~1.6MB, use frame pointers instead;
# the trace/tracing stack (FTRACE,  uprobes, ...) is only useful on real hosts.
CONFIG_UNWINDER_FRAME_POINTER=y
# CONFIG_UNWINDER_ORC is not set
# CONFIG_PERF_EVENTS_INTEL_UNCORE is not set
# CONFIG_PERF_EVENTS_INTEL_RAPL is not set
# CONFIG_PERF_EVENTS_INTEL_CSTATE is not set
# CONFIG_PERF_EVENTS_AMD_UNCORE is not set
# CONFIG_UPROBES is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_TRACING is not set
# CONFIG_TRACEPOINTS is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_NVME is not set
# CONFIG_MICROCODE_AMD is not set
# CONFIG_EFI is not set
# CONFIG_SOUND is not set
# CONFIG_HID is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set

# Misc userspace ABI
CONFIG_FHANDLE=y
CONFIG_DNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FUTEX=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_SYSCTL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Security frameworks (AppArmor + SELinux)
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,apparmor,selinux,bpf"

# No debug info/BTF - keeps the build fast and the image small
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set