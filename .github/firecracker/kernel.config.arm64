# Minimal Linux 6.18 LTS kernel config for Firecracker microVMs (aarch64).
# Size-optimized (-Os): targets a ~10 MB vmlinux image.

# EXPERT=y is required so SLUB_TINY (and friends) can be turned on via
# olddefconfig. Verified safe for this fragment: the only
# EXPERT-sensitive default (NAMESPACES) is pinned explicitly below.
CONFIG_EXPERT=y

# Disable modules - build a fully static, self-contained kernel.
# CONFIG_MODULES is not set

CONFIG_LOCALVERSION="-openworld"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="(none)"

# General setup
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
# CONFIG_WATCH_QUEUE is not set
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_AUDIT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# xz BCJ filters for foreign CPU architectures: plain xz payloads
# (incl. initramfs) decode without them; keep only the native ARM64 one.
# CONFIG_XZ_DEC_X86 is not set
# CONFIG_XZ_DEC_POWERPC is not set
# CONFIG_XZ_DEC_ARM is not set
# CONFIG_XZ_DEC_ARMTHUMB is not set
# CONFIG_XZ_DEC_SPARC is not set
# CONFIG_XZ_DEC_RISCV is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_MICROVM=y

# Processor type and features (arm64)
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_HZ_250=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y

# Bus options - no PCI (Firecracker microVM uses the virtio-MMIO transport)
# CONFIG_PCI is not set
# CONFIG_PCI_MSI is not set
# CONFIG_PCIEPORTBUS is not set
# CONFIG_PCI_HOST_GENERIC is not set
CONFIG_ARM_AMBA=y

# Partition types
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# CONFIG_MQ_IOSCHED_KYBER is not set

# Networking - Firecracker guest sees virtio-net only: no physical
# Ethernet NICs (disabling ETHERNET drops all NET_VENDOR_* drivers),
# no wireless, no Bluetooth. Container networking (veth/bridge/
# netfilter) stays as-is: enabling it would grow the image.
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
CONFIG_VSOCKETS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# Device drivers
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
# Maximum-reclaim virtio-balloon: movable balloon pages (compaction +
# migration), host free-page reporting, and full vmstat counters so the host
# sees swap/fault/stall/scan pressure. Patched driver batching lives in
# .github/firecracker/patches/0001-virtio-balloon-aggressive-inflate.patch
# through 0010-balloon-backoff-on-zero-progress.patch.
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_BALLOON_COMPACTION=y
CONFIG_PAGE_REPORTING=y
CONFIG_VM_EVENT_COUNTERS=y
# Smaller slab footprint: less unreclaimable kernel memory, so the balloon
# ceiling is higher (and the image is smaller). Costs allocator throughput
# on slab-heavy workloads - revert for those guests.
CONFIG_SLUB_TINY=y
# Merge same-size slab caches: less fragmentation, more memory ends up
# balloonable instead of stranded in half-empty slabs.
CONFIG_SLAB_MERGE_DEFAULT=y
# Multi-gen LRU, enabled by default: better file-cache reclaim under
# pressure, so reclaim-allowed balloon allocations (0002) convert cache
# into host-reclaimable memory instead of grinding.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# No transparent hugepages: THP collapses free memory into pinned 2MB
# compound pages the balloon cannot take order-0, fragmenting the guest
# and stranding host memory. Balloon + reporting work best on 4K pages.
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# No hugetlbfs pool: hugetlb pages are pinned and unballoonable, plus
# metadata overhead.
# CONFIG_HUGETLBFS is not set
# Small printk ring (16KB): saves pinned kernel memory. Increase if you
# lose boot logs.
CONFIG_LOG_BUF_SHIFT=14
# Idle-page tracking: lets host-side policy see which guest pages are cold
# (/sys/kernel/mm/page_idle/bitmap) for smarter per-VM balloon targets.
CONFIG_IDLE_PAGE_TRACKING=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# CONFIG_VIRTIO_PCI is not set
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_VSOCKETS=y
# No keyboard/mouse in a microVM (VT selects INPUT, so the core stays,
# but all input-device drivers go).
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_EVDEV is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_MOUSE_PS2 is not set
# CONFIG_SERIO_I8042 is not set

# No power management in a microVM (no battery, fan, thermal, suspend
# or CPU frequency scaling).
# CONFIG_PM is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_HWMON is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_PPS is not set

# Serial console (Firecracker requirement)
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set

# Disable host-oriented subsystems and unneeded instrumentation.
# Firecracker-only guest: no platform drivers, no host-side vhost,
# no physical storage/media/bus drivers, no tracing (matches x86).
# CONFIG_ARM64_PLATFORM_DEVICES is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_VHOST_MENU is not set
# CONFIG_VDPA is not set
# CONFIG_UPROBES is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_TRACING is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_NVME_CORE is not set
# CONFIG_NVME_FABRICS is not set
# CONFIG_MMC is not set
# CONFIG_MEMSTICK is not set
# CONFIG_MTD is not set
# CONFIG_EFI is not set
# CONFIG_SOUND is not set
# CONFIG_HID is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set

# Filesystems
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Misc userspace ABI
CONFIG_FHANDLE=y
CONFIG_DNOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FUTEX=y
# CONFIG_KALLSYMS is not set
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_SYSCTL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# No debug info/BTF - keeps the build fast and the image small
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Security frameworks (AppArmor + SELinux)
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,apparmor,selinux,bpf"
